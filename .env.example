# Порты на хосте. Для реального домена (prival.pro) оставьте 80/443 —
# так сайт открывается без порта в адресе: https://prival.pro
FRONTEND_PORT=80
FRONTEND_SSL_PORT=443
# Не обязателен для работы сайта — nginx проксирует /api по внутренней docker-сети.
# Открыт наружу только для удобства прямого захода в /docs при отладке.
BACKEND_PORT=8000
DB_PORT=5432

DB_USER=privalcafe
DB_PASSWORD=privalcafe
DB_NAME=privalcafe

# Обычно оставляйте пустым: фронтенд ходит в API по относительному пути (/api/...),
# nginx этого же контейнера проксирует его на backend — работает на любом домене/IP без CORS.
# Заполняйте, только если запускаете `npm run dev` локально без nginx (например http://localhost:8000).
VITE_API_URL=

# Код входа в админ-панель (проверяется на бэкенде).
ADMIN_PASSCODE=privaladmin

# Секрет для подписи JWT-токенов админки. Сгенерировать: openssl rand -base64 48
JWT_SECRET=

# Ключ шифрования пароля приложения (для отправки писем) при хранении в БД.
# Сгенерировать: openssl rand -base64 32 | tr '+/' '-_'
ENCRYPTION_KEY=

# Источники, которым разрешено ходить в API напрямую (через запятую).
# При обычной работе через nginx-прокси браузер вообще не делает кросс-доменных запросов —
# это нужно только как страховка / для прямых обращений к API в обход прокси.
CORS_ORIGINS=https://prival.pro,https://www.prival.pro,http://prival.pro,http://www.prival.pro

# На этот адрес Let's Encrypt пришлёт уведомление, если сертификат не продлится сам.
# Нужен только для scripts/init-letsencrypt.sh.
CERTBOT_EMAIL=
