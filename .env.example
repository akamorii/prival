FRONTEND_PORT=8080
BACKEND_PORT=8000
DB_PORT=5432

DB_USER=privalcafe
DB_PASSWORD=privalcafe
DB_NAME=privalcafe

# URL бэкенда, вшивается в сборку фронтенда (браузер должен уметь до него достучаться).
VITE_API_URL=http://localhost:8000
# Код входа в админ-панель — передаётся и во фронтенд (сравнение на бэкенде), и в backend как ADMIN_PASSCODE.
VITE_ADMIN_PASSCODE=privaladmin

# Секрет для подписи JWT-токенов админки. Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Ключ шифрования пароля приложения (для отправки писем) при хранении в БД.
# Сгенерировать: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Домены, которым разрешено ходить в API (через запятую).
# Указывайте и localhost, и 127.0.0.1 — браузер считает их разными источниками.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
